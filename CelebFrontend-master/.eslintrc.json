{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended"
  ],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": [
    "react",
    "unused-imports"   // Added unused-imports plugin
  ],
  "rules": {
    "no-unused-vars": "warn",   // Warns for unused variables
    "react/prop-types": "off",  // Optional if you use TypeScript
    "react/react-in-jsx-scope": "off", // React 17 JSX Transform
    "unused-imports/no-unused-imports": "warn",   // New rule to catch unused imports (including components)
    "unused-imports/no-unused-vars": "warn"  // Warns for unused variables in imports
  }
}
